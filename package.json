{
  "name": "@jbowes/repl",
  "version": "1.0.0",
  "description": "static site gen",
  "main": "src/index.js",
  "repository": "git@github.com:jbowes/repl.git",
  "author": "James Bowes <jbowes@repl.ca>",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "webpack serve --hot --port 5000",
    "build": "webpack --progress",
    "css": "postcss --no-map -o public/css/style.css src/css/style.css",
    "test": "node --test test/",
    "check:images": "node scripts/check-images.js",
    "images:fix": "node scripts/check-images.js --fix",
    "prepare": "git config core.hooksPath .githooks || true",
    "release": "npm run build && npm run css && node scripts/inline-css.js"
  },
  "dependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/register": "^8.0.6",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "cssnano": "^9.9.0",
    "eval": "^0.1.8",
    "js-yaml": "^5.5.0",
    "moment": "^2.31.0",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-react": "^8.0.0",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-rehype": "^11.1.2",
    "sitemap-webpack-plugin": "^1.1.1",
    "unist-builder": "^4.0.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "overrides": {
    "glob": "^14.0.4"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
